// Mr Rent A Car — core schema
// Source of truth: project-spec.md "Data Model Summary" + field-by-field capture of the
// live RentCentric "Add/New" forms (VehicleAdd, QuotesModify, ReservationsModfiy,
// CheckOut3, CustomerInfo, CompaniesModify, RatesModifyNew2, MiscChargesMain).
//
// Conventions
//   /// LEGACY      field flagged in the spec as a likely legacy carry-over (pending client)
//   /// CONFIRM     exists on the live form but purpose/need is unclear — asking before dropping
//   /// VERIFY      shape inferred; re-check against the live screen when that module is built
//   legacyId        RentCentric primary key, kept for the CSV import / migration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth (Better-Auth core tables + admin plugin fields)
// ─────────────────────────────────────────────────────────────────────────────

enum UserKind {
  STAFF
  CUSTOMER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Better-Auth admin plugin
  role          String?
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?

  kind              UserKind   @default(STAFF)
  userGroupId       String?
  userGroup         UserGroup? @relation(fields: [userGroupId], references: [id])
  defaultLocationId String?
  defaultLocation   Location?  @relation("UserDefaultLocation", fields: [defaultLocationId], references: [id])
  customer          Customer?  @relation("CustomerPortalUser")

  sessions Session[]
  accounts Account[]

  rentalsOpened       Rental[]      @relation("RentalOpenedBy")
  rentalsClosed       Rental[]      @relation("RentalClosedBy")
  paymentsTaken       Payment[]     @relation("PaymentTakenBy")
  memosAuthored       Memo[]        @relation("MemoAuthor")
  quotesCreated       Quote[]       @relation("QuoteCreatedBy")
  reservationsCreated Reservation[] @relation("ReservationCreatedBy")
  adjustmentsEntered  Adjustment[]  @relation("AdjustmentEnteredBy")
  commissionsEntered  Commission[]  @relation("CommissionEnteredBy")
  commissionsEarned   Commission[]  @relation("CommissionUser")
  auditLogs           AuditLog[]

  @@map("user")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

/// Staff permission group (Settings > Users). VERIFY: permission keys once Settings > Users is audited.
/// Settings > Users > User Groups (AdminGroupsModify.aspx). `permissions` holds RentCentric's checkbox ids
/// (see packages/api/src/lib/permissions.ts). Users with the admin role ("Full Admin") can do everything.
model UserGroup {
  id               String        @id @default(cuid())
  legacyId         Int?          @unique
  name             String        @unique
  isActive         Boolean       @default(true)
  /// "Location:" — null = ALL locations
  locationId       String?
  /// "Max Discount: % / $"
  maxDiscountType  DiscountType?
  maxDiscountValue Decimal?      @db.Decimal(10, 2)
  permissions      String[]
  users            User[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Locations & lookups
// ─────────────────────────────────────────────────────────────────────────────

/// Live DB has 6: Richmond, Burnaby, Vancouver Admin Office, Surrey, YYC Offsite, YVR Offsite
/// (+ Coquitlam in the location switcher).
model Location {
  id                     String        @id @default(cuid())
  legacyId               Int?          @unique
  name                   String
  address1               String?
  address2               String?
  city                   String?
  province               String?
  postal                 String?
  country                String?       @default("CA")
  phone                  String?
  fax                    String?
  email                  String?
  isOffsite              Boolean       @default(false)
  isLegacy               Boolean       @default(false)
  /// IANA zone for all times at this location (bookings are local wall-clock time)
  timeZone               String        @default("America/Vancouver")
  hoursNote              String? /// e.g. "24 hour key drop box" (public Our Locations page)
  isActive               Boolean       @default(true)
  // legacy Settings > Locations (LocationsModify.aspx)
  code                   String? /// "Location Code", e.g. MRRMD
  displayOnline          Boolean       @default(false) /// "Web Customer": offered on the public site
  tollFree               String?
  closestIntersection    String?
  closestAirport         String?
  latitude               Decimal?      @db.Decimal(9, 6)
  longitude              Decimal?      @db.Decimal(9, 6)
  minimumAge             Int?
  underAge               Int? /// renters younger than this pay the underage charge
  legalName              String? /// "Legal Name" on Location settings; heads the printed contract
  gstNumber              String? /// "GST Number" on Location settings; printed under the address on the Customer Invoice
  quoteExpiresAfter      Int           @default(0) /// days; a quote shows "Expired" after this (0 = never)
  /// Location settings fuel prices (per litre): "Convenience ReFuel" (printed as ReFuel on the contract) and prepaid, gas / diesel
  /// Settings > Default Payment Method: a built-in method (VISA, CASH …) or "OTHER:<name>"
  defaultPaymentMethod   String?
  refuelPrice            Decimal?      @db.Decimal(10, 2)
  dieselRefuelPrice      Decimal?      @db.Decimal(10, 2)
  prepaidFuelPrice       Decimal?      @db.Decimal(10, 2)
  dieselPrepaidFuelPrice Decimal?      @db.Decimal(10, 2)
  memo                   String?
  /// Settings > Upload Logo: the location's logo (storage key), printed at ##LogoImage##
  logoKey                String?
  /// One Way Region (LocationsModify.aspx "Region"): one-way fees are set between regions
  oneWayRegionId         String?
  oneWayRegion           OneWayRegion? @relation(fields: [oneWayRegionId], references: [id], onDelete: SetNull)

  vehicleTypes VehicleTypeLocation[]

  hours       LocationHours[]
  miscCharges MiscCharge[]
  insurances  Insurance[]
  taxes       LocationTax[]

  usersDefaulted     User[]                  @relation("UserDefaultLocation")
  vehiclesRental     Vehicle[]               @relation("VehicleRentalLocation")
  vehiclesOwning     Vehicle[]               @relation("VehicleOwningLocation")
  vehiclesCurrent    Vehicle[]               @relation("VehicleCurrentLocation")
  rates              Rate[]
  quotesPickup       Quote[]                 @relation("QuotePickup")
  quotesReturn       Quote[]                 @relation("QuoteReturn")
  reservationsBooked Reservation[]           @relation("ReservationLocation")
  reservationsPickup Reservation[]           @relation("ReservationPickup")
  reservationsReturn Reservation[]           @relation("ReservationReturn")
  rentalsOut         Rental[]                @relation("RentalCheckOutLocation")
  rentalsIn          Rental[]                @relation("RentalCheckInLocation")
  customersDefault   Customer[]              @relation("CustomerDefaultLocation")
  customersEntered   Customer[]              @relation("CustomerEnteredLocation")
  transportsPickup   Transport[]             @relation("TransportPickup")
  transportsDropoff  Transport[]             @relation("TransportDropoff")
  documentTemplates  DocumentTemplate[]
  paymentMethods     LocationPaymentMethod[]
}

/// Settings > Location Information > Hours Of Operation
model LocationHours {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0 = Sunday
  opensAt    String? // "09:00"
  closesAt   String?
  isClosed   Boolean  @default(false)

  @@unique([locationId, dayOfWeek])
}

/// Simple admin-editable pick-lists that are just a name. One table instead of ten.
enum LookupKind {
  VEHICLE_CATEGORY
  VEHICLE_BODY // 15 Pass. Van, ATV, Car, Dirt Bike, Minivan, Snowmobile, Street Motorcycle, SUV, Trailer, Truck, Water Craft
  FUEL_TYPE // Gas, Diesel, Petrol, Electric, Bicycle, Regular
  ENGINE_BRAND
  ENGINE_TYPE
  VEHICLE_OPTION // Game System X-box, Tow Hitch, Satellite Radio, DVD, ...
  COMPANY_TYPE // Affiliate, Auto Glass, ..., ICBC, Insurance, Travel Wholesaler (21 values)
  CUSTOMER_REGION // Burnaby, Coquitlam, Richmond, ...
  DISCOUNT_REASON
  RENTAL_REASON
  PAYMENT_DETAIL // Settings > Payment Details: the "Detail" choices on Add/Edit Other Charges (empty in RentCentric today)
  DAMAGE_LOCATION // Settings > Vehicle Setup > Damage Setup > Damage Locations (spots on the car diagram)
  DAMAGE_CONDITION // Damage Setup > Damage Conditions: Broken, Crack, Dent, Rock Chip, Rust, Scratch. Chip
}

model Lookup {
  id        String     @id @default(cuid())
  kind      LookupKind
  name      String
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)

  vehiclesCategory         Vehicle[]                @relation("VehicleCategory")
  vehiclesBody             Vehicle[]                @relation("VehicleBody")
  vehiclesFuelType         Vehicle[]                @relation("VehicleFuelType")
  vehiclesEngineBrand      Vehicle[]                @relation("VehicleEngineBrand")
  vehiclesEngineType       Vehicle[]                @relation("VehicleEngineType")
  vehicleOptions           VehicleOption[]
  companies                Company[]
  customersRegion          Customer[]
  reservationsDiscount     Reservation[]
  rentalsDiscount          Rental[]                 @relation("RentalDiscountReason")
  rentalsReason            Rental[]                 @relation("RentalReason")
  damagesLocation          VehicleDamage[]          @relation("DamageLocation")
  damagesCondition         VehicleDamage[]          @relation("DamageCondition")
  reportedDamagesLocation  CustomerReportedDamage[] @relation("ReportedDamageLocation")
  reportedDamagesCondition CustomerReportedDamage[] @relation("ReportedDamageCondition")

  @@unique([kind, name])
}

/// Referrals (ReferralsQuickAdd.aspx: Referral/Company Name, Full Name, Email, Phone, Fax, Memo)
model Referral {
  id           String        @id @default(cuid())
  legacyId     Int?          @unique
  name         String        @unique
  fullName     String?
  email        String?
  phone        String?
  fax          String?
  memo         String?
  isActive     Boolean       @default(true)
  quotes       Quote[]
  reservations Reservation[]
  rentals      Rental[]
  customers    Customer[]
  commissions  Commission[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Fleet
// ─────────────────────────────────────────────────────────────────────────────

/// ~50 active classes (Economy … Model 3/X/Y, VAN 15 Passenger Minibus). Drives rate lookup + availability.
/// seats/luggage/doors are shown per class on mrrentacar.com/fleet.
model VehicleType {
  id                           String    @id @default(cuid())
  legacyId                     Int?      @unique
  name                         String    @unique
  sippCode                     String? /// Settings > Vehicle Setup > SIPP Codes
  description                  String?
  seats                        Int?
  luggage                      Int?
  doors                        Int?
  imageKey                     String? // S3
  displayOnline                Boolean   @default(true)
  sortOrder                    Int       @default(0)
  isActive                     Boolean   @default(true)
  // legacy Settings > Vehicle Setup > Types (VehicleTypesModify.aspx)
  code                         String? /// "Vehicle Type Code"
  smallBags                    Int?
  largeBags                    Int?
  transmission                 String?
  minimumAge                   Int?
  deposit                      Decimal?  @db.Decimal(10, 2)
  depositType                  String? /// Flat / Percent
  depositRequiredAtReservation Boolean   @default(false)
  alwaysAvailable              Boolean   @default(false)
  airConditioner               Boolean   @default(false)
  specUrl                      String?
  videoUrl                     String?
  effectiveDate                DateTime? @db.Date
  endDate                      DateTime? @db.Date

  vehicles     Vehicle[]
  locations    VehicleTypeLocation[]
  rateValues   RateValue[]
  miscCharges  MiscChargeVehicleType[]
  insurances   InsuranceVehicleType[]
  quotes       Quote[]
  reservations Reservation[]
  rentals      Rental[]
  oneWayRates  OneWayRate[]
}

/// A class as offered at one location. RentCentric keeps a separate copy of every class per location
/// (its own VehicleTypeID, photo, memo and "Web Customer" flag); the public fleet lists these per location.
model VehicleTypeLocation {
  id            String  @id @default(cuid())
  vehicleTypeId String
  locationId    String
  legacyId      Int?    @unique /// RentCentric VehicleTypeID at this location
  description   String? /// e.g. "Chrysler Grand Caravan 7-Passenger or Similar"; falls back to the class description
  imageKey      String? /// falls back to the class photo
  displayOnline Boolean @default(true)
  sortOrder     Int     @default(0) /// order on the public fleet page
  isActive      Boolean @default(true)

  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([vehicleTypeId, locationId])
  @@index([locationId, displayOnline, sortOrder])
}

model VehicleMake {
  id       String         @id @default(cuid())
  name     String         @unique
  models   VehicleModel[]
  vehicles Vehicle[]
}

model VehicleModel {
  id       String      @id @default(cuid())
  makeId   String
  make     VehicleMake @relation(fields: [makeId], references: [id])
  name     String
  vehicles Vehicle[]

  @@unique([makeId, name])
}

/// Same list and order as the RentCentric vehicle form (see packages/api/src/lib/vehicle-status.ts for labels).
enum VehicleStatus {
  ACCIDENT_REPLACEMENT
  AUCTION
  AVAILABLE
  COMPREHENSIVE
  FOR_SALE
  GROUNDED
  HAS_PROBLEM
  HOLD_FOR_SALE
  IN_CHECKOUT_PROCESS
  IN_REPAIR
  IN_SERVICE
  LEASED_REPLACEMENT
  ON_RENT
  OUT_OF_SERVICE
  SOLD
  STAFF
  STOLEN
}

enum Transmission {
  NONE
  AUTOMATIC
  MANUAL
  TIPTRONIC
}

enum PowerTrain {
  FOUR_BY_TWO
  FOUR_BY_FOUR
}

/// Add New Vehicle form, grouped the way the redesigned form will be.
model Vehicle {
  id       String  @id @default(cuid())
  legacyId Int?    @unique
  isActive Boolean @default(true)

  // ── Identity / spec
  assignedId    String        @unique /// "Assigned ID" — the unit number staff use
  name          String? /// "Vehicle Name"
  makeId        String
  make          VehicleMake   @relation(fields: [makeId], references: [id])
  modelId       String
  model         VehicleModel  @relation(fields: [modelId], references: [id])
  modelCode     String?
  year          Int?
  colour        String
  doors         Int?
  cylinders     Int?
  transmission  Transmission?
  vehicleTypeId String
  vehicleType   VehicleType   @relation(fields: [vehicleTypeId], references: [id])
  vin           String?       @unique
  memo          String?
  /// "Notes" (VehicleNotesModify.aspx), shown on the vehicle page
  notes         String?

  // ── Operations
  rentalLocationId  String
  rentalLocation    Location      @relation("VehicleRentalLocation", fields: [rentalLocationId], references: [id])
  owningLocationId  String
  owningLocation    Location      @relation("VehicleOwningLocation", fields: [owningLocationId], references: [id])
  currentLocationId String? /// "Current Rental / Offsite Location"
  currentLocation   Location?     @relation("VehicleCurrentLocation", fields: [currentLocationId], references: [id])
  status            VehicleStatus @default(AVAILABLE)
  categoryId        String?
  category          Lookup?       @relation("VehicleCategory", fields: [categoryId], references: [id])
  bodyId            String?
  body              Lookup?       @relation("VehicleBody", fields: [bodyId], references: [id])
  fuelTypeId        String?
  fuelType          Lookup?       @relation("VehicleFuelType", fields: [fuelTypeId], references: [id])
  tankSize          Int
  fuelLevel         Int           @default(16) /// sixteenths, 0–16 (legacy slider)
  originalOdometer  Int?
  currentOdometer   Int?
  spotNumber        String?
  keyNumber         String?
  isExclusiveFleet  Boolean       @default(false)

  // ── GPS (not on the legacy form). Manual entry until Moovetrax fills it (integrations phase).
  gpsTrackerId String?
  gpsLatitude  Decimal?  @db.Decimal(9, 6)
  gpsLongitude Decimal?  @db.Decimal(9, 6)
  gpsUpdatedAt DateTime?

  // ── Maintenance / insurance / legal
  maintenanceBeginOdometer Int?
  maintenanceBeginDate     DateTime? @db.Date
  maintenanceEveryKm       Int
  insuranceAmount          Decimal   @db.Decimal(10, 2)
  inspectionDate           DateTime? @db.Date
  inspectionAmount         Decimal?  @db.Decimal(10, 2)
  licenseNumber            String /// plate
  licenseProvince          String?
  licenseAmount            Decimal?  @db.Decimal(10, 2)
  licenseFirstRegistered   DateTime? @db.Date
  licenseExpiry            DateTime? @db.Date
  ldwMonthlyRate           Decimal?  @db.Decimal(10, 2)

  // ── Mechanical specs
  powerTrain        PowerTrain?
  fuelGrade         String?
  oilType           String?
  dimensions        String?
  maxPayload        String?
  verticalClearance String?
  frontTirePressure String?
  rearTirePressure  String?
  engineBrandId     String?
  engineBrand       Lookup?     @relation("VehicleEngineBrand", fields: [engineBrandId], references: [id])
  engineTypeId      String?
  engineType        Lookup?     @relation("VehicleEngineType", fields: [engineTypeId], references: [id])
  gvwr              String?
  cityMpg           Decimal?    @db.Decimal(5, 1)
  highwayMpg        Decimal?    @db.Decimal(5, 1)

  // ── Appearance & pricing
  interiorColor            String?
  interiorRgb              String? /// LEGACY
  exteriorRgb              String? /// LEGACY — this is the field the live form mislabels as a second "GVWR"
  stereo                   String? /// LEGACY
  subscriptionPlanId       String? /// CONFIRM: 7 external plan-ID fields — which (if any) are used?
  monthlyPlanId            String? /// CONFIRM
  yearlyPlanId             String? /// CONFIRM
  weeklyLowMileagePlanId   String? /// CONFIRM
  weeklyHighMileagePlanId  String? /// CONFIRM
  monthlyLowMileagePlanId  String? /// CONFIRM
  monthlyHighMileagePlanId String? /// CONFIRM
  marketingDescription     String?
  retailPriceLow           Decimal?        @db.Decimal(10, 2)
  retailPriceHigh          Decimal?        @db.Decimal(10, 2)
  options                  VehicleOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations   Reservation[]
  rentals        Rental[]
  blocks         VehicleBlock[]
  rentalSegments RentalVehicleSegment[]
  attachments    Attachment[]
  memos          Memo[]

  // Vehicle page sub-records (VehicleMain.aspx actions)
  maintenances     VehicleMaintenance[]
  repairs          VehicleRepair[]
  problems         VehicleProblem[]
  carwashes        VehicleCarwash[]
  damages          VehicleDamage[]
  accidents        VehicleAccident[]
  serviceVouchers  VehicleServiceVoucher[]
  insuranceRecords VehicleInsuranceRecord[]
  statusChanges    VehicleStatusChange[]
  inspections      VehicleInspection[]
  reportedDamages  CustomerReportedDamage[]
  checklists       VehicleChecklistRecord[]
  ownership        VehicleOwnership?
  condition        VehicleCondition?
  claims           Claim[]

  @@index([vehicleTypeId, rentalLocationId, status])
}

model VehicleOption {
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  optionId  String
  option    Lookup  @relation(fields: [optionId], references: [id])

  @@id([vehicleId, optionId])
}

/// One row per period a specific vehicle is committed (assigned reservation or open rental).
/// Double-booking is prevented in Postgres by an EXCLUDE USING gist constraint on
/// (vehicleId, tsrange(startsAt, endsAt)) — timestamps are stored as UTC — see prisma/sql/vehicle_block_exclusion.sql.
/// Also the data source for the Visual Scheduler replacement (vehicle × date × status).
model VehicleBlock {
  id            String       @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  startsAt      DateTime
  endsAt        DateTime
  reservationId String?      @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  rentalId      String?      @unique
  rental        Rental?      @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([vehicleId, startsAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Rates & charge catalogue
// ─────────────────────────────────────────────────────────────────────────────

enum RateCalculation {
  HOUR_24 // "24 Hour Time"
  CALENDAR_DAY
  FLAT
  PERCENT // misc charges only, e.g. "Premium Location Charge (9.75%)" — % of the other charges before tax
}

enum RateValidFor {
  DATE_RANGE
  SEASON
}

/// Settings > Rates > Master Rates. One rate code covers many vehicle types (RateValue)
/// and may be valid for a date range or a set of seasons.
model Rate {
  id                String          @id @default(cuid())
  legacyId          Int?            @unique
  code              String /// "Rate Code", e.g. "INT Fall End 3 to 6 Days"
  locationId        String
  location          Location        @relation(fields: [locationId], references: [id])
  calculationBy     RateCalculation
  rateType          String /// Standard, "N Day Multiday", "N Day Flat", Hourly/Daily/Weekly/Monthly Rate Only, Weekend, Min/Max Days, ... (~70 values)
  validFor          RateValidFor    @default(DATE_RANGE)
  effectiveDate     DateTime?       @db.Date
  endDate           DateTime?       @db.Date
  seasons           RateSeason[]
  extraKmCharge     Decimal         @db.Decimal(10, 2)
  graceMinutes      Int
  fuelChargePerUnit Decimal         @db.Decimal(10, 2)
  minChargeDays     Int
  minChargeHours    Int?
  /// Min/Max rental length this rate applies to ("Min/Max+Regular": e.g. 1–3 days). 0 = no limit.
  minDays           Int             @default(0)
  minHours          Int             @default(0)
  minMinutes        Int             @default(0)
  maxDays           Int             @default(0)
  maxHours          Int             @default(0)
  maxMinutes        Int             @default(0)
  /// "Available On": pickup weekdays, Sun..Sat
  availableDays     Boolean[]       @default([true, true, true, true, true, true, true])
  skipHourly        Boolean         @default(false)
  displayOnline     Boolean         @default(false)
  valuePricing      Boolean         @default(false)
  dateSpecific      Boolean         @default(false)
  rentcarsCom       Boolean         @default(false) /// CONFIRM: Rentcars.com channel flag — still used?
  isActive          Boolean         @default(true)

  values       RateValue[]
  quotes       Quote[]
  reservations Reservation[]
  rentals      Rental[]

  @@unique([locationId, code])
}

/// VERIFY: exact value columns appear per vehicle type once types are ticked on the rate form.
/// Money columns keep 8 decimals like RentCentric, which stores rates unrounded (e.g. 46.33004719/day) and rounds only the line total.
model RateValue {
  id            String      @id @default(cuid())
  rateId        String
  rate          Rate        @relation(fields: [rateId], references: [id], onDelete: Cascade)
  vehicleTypeId String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])
  /// Seasonal rates have one row per season; date-range rates have seasonId = null.
  seasonId      String?
  season        Season?     @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  hourly        Decimal?    @db.Decimal(16, 8)
  daily         Decimal?    @db.Decimal(16, 8)
  extraDaily    Decimal?    @db.Decimal(16, 8) /// "X" — extra day beyond the weekly/monthly block
  weekly        Decimal?    @db.Decimal(16, 8)
  monthly       Decimal?    @db.Decimal(16, 8)
  kmAllowed     Int? /// km per day ("KM Daily"); shows as "Km Allowed" on every charge table
  kmHourly      Int?
  kmWeekly      Int?
  kmMonthly     Int?
  extraKmCharge Decimal?    @db.Decimal(10, 2)

  @@unique([rateId, vehicleTypeId, seasonId])
}

/// VERIFY: Settings > Rates > Seasons
model Season {
  id         String       @id @default(cuid())
  locationId String?
  name       String       @unique
  /// month/day window; the year is ignored (seasons repeat yearly in RentCentric)
  startDate  DateTime     @db.Date
  endDate    DateTime     @db.Date
  rates      RateSeason[]
  rateValues RateValue[]
}

model RateSeason {
  rateId   String
  rate     Rate   @relation(fields: [rateId], references: [id], onDelete: Cascade)
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@id([rateId, seasonId])
}

/// Settings > Rates > Miscellaneous Charges (Additional Driver $15/24h, Admin Fee $100 flat,
/// Booster Seat, out-of-province use, Damage Waiver, Energy Recovery Fee, ...).
/// Settings > Rates > Miscellaneous Charges (MiscChargesModify.aspx, Basic + Advanced tabs).
/// Defined per location in RentCentric. Weekly/monthly/hourly/extra-daily rates are stored as on the form.
model MiscCharge {
  id                       String                  @id @default(cuid())
  legacyId                 Int?                    @unique
  locationId               String? /// null = all locations
  location                 Location?               @relation(fields: [locationId], references: [id])
  name                     String
  code                     String
  calculationBy            RateCalculation
  rate                     Decimal                 @db.Decimal(10, 2) /// daily rate (or % for PERCENT, or amount for FLAT)
  hourlyRate               Decimal?                @db.Decimal(10, 2)
  weeklyRate               Decimal?                @db.Decimal(10, 2)
  monthlyRate              Decimal?                @db.Decimal(10, 2)
  extraDailyRate           Decimal?                @db.Decimal(10, 2)
  graceMinutes             Int                     @default(0)
  milesIncluded            Int                     @default(0)
  effectiveDate            DateTime?               @db.Date
  endDate                  DateTime?               @db.Date
  minDays                  Int                     @default(0)
  maxDays                  Int                     @default(0) /// 0 = no cap
  group                    String? /// "under age", "OOP", "Snow Tire" — only one charge per group
  description              String? /// shown online under "(Details)"
  imageKey                 String?
  allVehicleTypes          Boolean                 @default(true)
  vehicleTypes             MiscChargeVehicleType[]
  displayOnline            Boolean                 @default(false)
  rentcarsCom              Boolean                 @default(false) /// CONFIRM
  defaultRentcarsCom       Boolean                 @default(false) /// CONFIRM
  isMandatory              Boolean                 @default(false)
  /// "Default MiscCharge": added automatically to every booking (pre-checked and locked online)
  isDefault                Boolean                 @default(false)
  valuePricing             Boolean                 @default(false) /// use cheapest of daily/weekly/monthly
  autoWhenUnderAge         Boolean                 @default(false) /// "Driver is underage"
  autoWhenAdditionalDriver Boolean                 @default(false) /// "Additional Driver is added"
  isPrepaidFuel            Boolean                 @default(false)
  isNoShowCharge           Boolean                 @default(false)
  multiSelectOnline        Boolean                 @default(false) /// "Enable Multi Selection Online" (quantity > 1)
  displayAtStartRental     Boolean                 @default(true)
  displayAtEndRental       Boolean                 @default(true)
  tollAdminFeeWaiver       Boolean                 @default(false)
  isActive                 Boolean                 @default(true)
  chargeLines              ChargeLine[]
  adjustments              Adjustment[]
  signatureSetups          SignatureSetup[]
}

model MiscChargeVehicleType {
  miscChargeId  String
  miscCharge    MiscCharge  @relation(fields: [miscChargeId], references: [id], onDelete: Cascade)
  vehicleTypeId String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)

  @@id([miscChargeId, vehicleTypeId])
}

/// Settings > Rates > Insurance Coverage (InsurancesModify.aspx): damage waivers / SLC / No Protection.
/// Online these are the "Protections & Coverages" radio list — the renter picks exactly one.
model Insurance {
  id                 String                 @id @default(cuid())
  legacyId           Int?                   @unique
  locationId         String?
  location           Location?              @relation(fields: [locationId], references: [id])
  name               String
  code               String
  calculationBy      RateCalculation
  hourlyRate         Decimal?               @db.Decimal(10, 2)
  dailyRate          Decimal                @db.Decimal(10, 2)
  weeklyRate         Decimal?               @db.Decimal(10, 2)
  monthlyRate        Decimal?               @db.Decimal(10, 2)
  extraDailyRate     Decimal?               @db.Decimal(10, 2)
  deductible         Decimal?               @db.Decimal(10, 2)
  graceMinutes       Int                    @default(0)
  effectiveDate      DateTime?              @db.Date
  endDate            DateTime?              @db.Date
  minDays            Int                    @default(0)
  maxDays            Int                    @default(0)
  group              String? /// e.g. "ODW"
  description        String?
  imageKey           String?
  allVehicleTypes    Boolean                @default(true)
  vehicleTypes       InsuranceVehicleType[]
  displayOnline      Boolean                @default(false)
  rentcarsCom        Boolean                @default(false) /// CONFIRM
  defaultRentcarsCom Boolean                @default(false) /// CONFIRM
  valuePricing       Boolean                @default(false)
  isDeposit          Boolean                @default(false)
  isDefault          Boolean                @default(false) /// "Default Insurance": pre-selected
  isActive           Boolean                @default(true)
  chargeLines        ChargeLine[]
  signatureSetups    SignatureSetup[]
}

model InsuranceVehicleType {
  insuranceId   String
  insurance     Insurance   @relation(fields: [insuranceId], references: [id], onDelete: Cascade)
  vehicleTypeId String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)

  @@id([insuranceId, vehicleTypeId])
}

/// VERIFY: Settings > Rates > Taxes (GST / PST seen on charge tables)
enum TaxKind {
  PERCENT
  AMOUNT
}

/// Settings > Rates > Taxes. Live: Goods & Services Tax 5%, GST(Gas) 5%, Provincial Sales Tax 7%,
/// Passenger Vehicle Rental Tax $1.50/day (+ Credit, + ICBC variant), Tire Recovery $0.99, WRITEOFF ±$0.01.
model Tax {
  id          String         @id @default(cuid())
  name        String
  kind        TaxKind        @default(PERCENT)
  value       Decimal        @db.Decimal(10, 3) /// percent for PERCENT, dollars for AMOUNT
  perDay      Boolean        @default(false) /// VERIFY per tax (PVRT is per day)
  isActive    Boolean        @default(true)
  chargeLines ChargeLine[]
  billSplits  BillSplitTax[]
  locations   LocationTax[]
}

/// Which taxes apply at which location. VERIFY against Settings > Rates > Taxes per location.
model LocationTax {
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  taxId      String
  tax        Tax      @relation(fields: [taxId], references: [id], onDelete: Cascade)

  /// RentCentric TaxID at this location (TaxesModify.aspx)
  legacyId      Int?     @unique
  /// RentCentric tax code at this location, printed on invoices ("GST 5%", "PVRT $1.5@Day G")
  code          String?
  /// false = no "Apply to" rules imported: the % applies to the whole subtotal (old behaviour)
  hasRules      Boolean  @default(false)
  /// "Apply to" ticks: TIME, MILEAGE, MISC (all), INSURANCE (all), TAX (all taxable), FUEL, DAMAGE, ONE_WAY, OTHER1..OTHER4
  appliesTo     String[] @default([])
  /// the misc charges / insurances / taxes ticked in the tax's lists
  miscChargeIds String[] @default([])
  insuranceIds  String[] @default([])
  taxIds        String[] @default([])

  @@id([locationId, taxId])
}

/// VERIFY: Settings > Equipment Setup (GPS, infant seats — separately inventoried)
model Equipment {
  id       String  @id @default(cuid())
  name     String
  quantity Int     @default(0)
  isActive Boolean @default(true)
}

// ─────────────────────────────────────────────────────────────────────────────
// Customers & companies
// ─────────────────────────────────────────────────────────────────────────────

/// Settings > Company > Companies / Corporates (insurance, corporate, dealership, body shop, ICBC, ...)
model Company {
  id                    String    @id @default(cuid())
  legacyId              Int?      @unique
  name                  String
  typeId                String?
  type                  Lookup?   @relation(fields: [typeId], references: [id])
  code                  String?
  contactName           String?
  address1              String?
  address2              String?
  city                  String?
  province              String?
  postal                String?
  country               String?
  phone                 String?
  fax                   String?
  email                 String?
  taxName               String?
  taxAddress            String?
  taxId                 String?
  claimsOffice          String?
  minimumAge            Int?
