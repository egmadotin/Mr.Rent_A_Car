enum InsuranceType {
  LIABILITY_ONLY
  FULL_COVERAGE
}

enum IdentityVerificationMethod {
  MANUAL // staff ticked "License Validated"
  PLUSTEK // counter scan (future phase)
  PLAID // remote KYC (future phase)
  YOTI // CONFIRM: live form has "Check Yoti Verification"
}

/// Customer and driver are the same record. Additional drivers are Customers linked to a
/// primary via primaryCustomerId, and attached per booking through BookingDriver.
model Customer {
  id       String  @id @default(cuid())
  legacyId Int?    @unique
  isActive Boolean @default(true)

  title      String? /// Mr / Mrs / Ms / Miss / Dr
  firstName  String
  middleName String?
  lastName   String
  gender     String?
  birthDate  DateTime? @db.Date

  address1 String?
  address2 String?
  city     String?
  province String?
  postal   String?
  country  String?
  regionId String?
  region   Lookup? @relation(fields: [regionId], references: [id])

  phone                 String?
  cellPhone             String?
  localPhone            String?
  email                 String?
  emergencyContactPhone String?

  licenseNumber      String?
  licenseExpiry      DateTime? @db.Date
  licenseProvince    String?
  licenseCountry     String?
  motorcycleLicensed Boolean?

  // Identity verification — first-class regardless of path (spec: Plaid section)
  /// Legacy "Validated" checkbox next to the licence number. Staff tick it by hand today (method MANUAL);
  /// Plustek/Plaid fill the same fields automatically in the integrations phase.
  identityVerified       Boolean                     @default(false)
  identityVerifiedMethod IdentityVerificationMethod?
  identityVerifiedAt     DateTime?
  identityVerifiedById   String?
  checkYotiVerification  Boolean                     @default(false) /// CONFIRM: is Yoti in use?

  insuranceCompany      String?
  insurancePolicyNumber String?
  insurancePolicyHolder String?
  insuranceType         InsuranceType?
  insuranceExpiry       DateTime?      @db.Date
  insurancePhone        String?
  insuranceFax          String?

  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id])
  companyPhone String?
  jobPosition  String?
  referralId   String? /// "Source of Referral"
  referral     Referral? @relation(fields: [referralId], references: [id])

  passportNumber      String?
  aaaMembershipNumber String?
  frequentTravelerId  String?
  taxId               String?
  hstNumber           String?
  dbaName             String?
  bandName            String? /// CONFIRM: First Nations band name (tax-exempt status?) — keep?
  pin                 String? /// CONFIRM: what is the PIN used for?
  ssn                 String? /// CONFIRM: sensitive — needed at all?

  approvedBy          String?
  defaultLocationId   String?
  defaultLocation     Location? @relation("CustomerDefaultLocation", fields: [defaultLocationId], references: [id])
  enteredLocationId   String?
  enteredLocation     Location? @relation("CustomerEnteredLocation", fields: [enteredLocationId], references: [id])
  registrationChannel String? /// spec: legacy data holds staff emails here — fix in migration

  isUndesired               Boolean @default(false) /// do-not-rent list
  isPreferred               Boolean @default(false)
  isClubMember              Boolean @default(false)
  unsubscribedFromMarketing Boolean @default(false)
  allVehicleBodies          Boolean @default(false) /// CONFIRM: "All Vehicle Bodies" checkbox meaning

  primaryCustomerId String?
  primaryCustomer   Customer?  @relation("LinkedDrivers", fields: [primaryCustomerId], references: [id])
  linkedDrivers     Customer[] @relation("LinkedDrivers")

  userId String? @unique
  user   User?   @relation("CustomerPortalUser", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditCards     CreditCard[]
  clubMembership  ClubMembership?
  quotes          Quote[]
  reservations    Reservation[]
  rentals         Rental[]
  bookingDrivers  BookingDriver[]
  payments        Payment[]
  attachments     Attachment[]
  memos           Memo[]
  reportedDamages CustomerReportedDamage[]

  // Duplicate detection ("Check Matching") runs on these at create time.
  @@index([lastName, firstName])
  @@index([phone])
  @@index([email])
  @@index([licenseNumber])
}

/// Tokenised only — never store PAN or CVV (legacy form collects CVV2; not carried over).
model CreditCard {
  id             String    @id @default(cuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  description    String?
  isActive       Boolean   @default(true)
  brand          String
  last4          String
  expMonth       Int
  expYear        Int
  holderName     String?
  processorToken String? // Stripe payment method id, once the processor is chosen
