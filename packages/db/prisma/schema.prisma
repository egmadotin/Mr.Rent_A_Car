  insuranceRep          String?
  policyNumber          String?
  policyExpiry          DateTime? @db.Date
  mileageCap            Int?
  iataNumber            String?
  parentIataId          String?
  parentIata            Company?  @relation("CompanyIataParent", fields: [parentIataId], references: [id])
