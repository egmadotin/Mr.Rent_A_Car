  payments       Payment[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Booking lifecycle: Quote → Reservation → Rental
// ─────────────────────────────────────────────────────────────────────────────

enum DiscountType {
  PERCENT
  AMOUNT
}

/// Add Quote form has no customer field; the quote list still shows Name / Phone.
model Quote {
  id               String        @id @default(cuid())
  number           Int           @unique @default(autoincrement())
  legacyId         Int?          @unique
  pickupAt         DateTime
  returnAt         DateTime
  pickupLocationId String
  pickupLocation   Location      @relation("QuotePickup", fields: [pickupLocationId], references: [id])
  returnLocationId String
  returnLocation   Location      @relation("QuoteReturn", fields: [returnLocationId], references: [id])
  vehicleTypeId    String
  vehicleType      VehicleType   @relation(fields: [vehicleTypeId], references: [id])
  rateId           String?
  rate             Rate?         @relation(fields: [rateId], references: [id])
  /// "Rate (i)" Rate Details: this booking's own rate values, replacing the rate's (RateDetails.aspx) — see lib/rate-override.ts
  rateOverride     Json?
  companyId        String?
  company          Company?      @relation(fields: [companyId], references: [id])
  discountType     DiscountType?
  discountValue    Decimal?      @db.Decimal(10, 2)
  referralId       String?
  referral         Referral?     @relation(fields: [referralId], references: [id])
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id])
  /// Quote contact (legacy Email/SMS Quote + Print Quote: First/Last name, Email, Phone)
  contactName      String? /// full name, kept for list/search
  firstName        String?
  lastName         String?
  email            String?
  contactPhone     String?
  /// taxes unticked in the options grid (tax-exempt for this booking)
  excludedTaxIds   String[]      @default([])
  createdById      String?
  createdBy        User?         @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  chargeLines  ChargeLine[]
  reservations Reservation[]
  rentals      Rental[]
  memos        Memo[]
}

enum ReservationStatus {
  TENTATIVE
  CONFIRMED
  CHECKED_OUT // converted to a Rental
  CHECKED_IN
  CANCELLED
  NO_SHOW
}

/// Legacy uses five independent checkboxes (Confirmed / Tentative / Cancelled / Checked Out /
/// Checked In); modelled as one status so contradictory combinations can't exist.
model Reservation {
  id       String            @id @default(cuid())
  number   Int               @unique @default(autoincrement())
  legacyId Int?              @unique
  status   ReservationStatus @default(TENTATIVE)

  // renter as typed on the reservation (may precede / differ from the customer record)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  firstName  String
  middleName String?
  lastName   String
  email      String?
  phone      String?

  locationId       String /// booking location
  location         Location    @relation("ReservationLocation", fields: [locationId], references: [id])
  pickupLocationId String
  pickupLocation   Location    @relation("ReservationPickup", fields: [pickupLocationId], references: [id])
  returnLocationId String
  returnLocation   Location    @relation("ReservationReturn", fields: [returnLocationId], references: [id])
  pickupAt         DateTime
  returnAt         DateTime
  vehicleTypeId    String
  vehicleType      VehicleType @relation(fields: [vehicleTypeId], references: [id])
  vehicleId        String? /// specific unit, optional until assigned
  vehicle          Vehicle?    @relation(fields: [vehicleId], references: [id])
  rateId           String?
  rate             Rate?       @relation(fields: [rateId], references: [id])
  /// "Rate (i)" Rate Details: this booking's own rate values, replacing the rate's (RateDetails.aspx) — see lib/rate-override.ts
  rateOverride     Json?
  companyId        String?
  company          Company?    @relation(fields: [companyId], references: [id])

  discountType     DiscountType?
  discountValue    Decimal?      @db.Decimal(10, 2)
  discountReasonId String?
  discountReason   Lookup?       @relation(fields: [discountReasonId], references: [id])
  deposit          Decimal?      @db.Decimal(10, 2)
  referralId       String?
  referral         Referral?     @relation(fields: [referralId], references: [id])

  deliveryAddress         String?
  airline                 String?
  flightNumber            String?
  hotel                   String?
  arrivalAirport          String?
  preferredLanguage       String?
  poNumber                String?
  roNumber                String?
  customerNotes           String?
  isLoaner                Boolean   @default(false)
  isNonRevenue            Boolean   @default(false)
  confirmationEmailSentAt DateTime?
  excludedTaxIds          String[]  @default([]) /// taxes unticked in the options grid
  reservationChannel      String? /// legacy "Reservation Channel" (e.g. counter / website)

  quoteId     String?
  quote       Quote?    @relation(fields: [quoteId], references: [id])
  createdById String?
  createdBy   User?     @relation("ReservationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?
  deletedAt   DateTime?

  transports      Transport[]
  billSplits      BillSplit[]
  drivers         BookingDriver[]
  chargeLines     ChargeLine[]
  payments        Payment[]
  memos           Memo[]
  rental          Rental?
  vehicleBlock    VehicleBlock?
  inspections     VehicleInspection[]
  reportedDamages CustomerReportedDamage[]
  checklists      VehicleChecklistRecord[]

  @@index([pickupAt])
  @@index([status, pickupLocationId])
}

/// Delivery / collection ("Pickup/Drop-off"). One row = a pickup leg and a drop-off leg, as on
/// the Reserve-screen modal and the rental's Pickup/Drop-off list. Belongs to a reservation or a rental.
model Transport {
  id            String       @id @default(cuid())
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  rentalId      String?
  rental        Rental?      @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  pickupLocationId   String?
  pickupLocation     Location? @relation("TransportPickup", fields: [pickupLocationId], references: [id])
  pickupLocationName String?
  pickupAddress      String?
  pickupCity         String?
  pickupProvince     String?
  pickupPostal       String?
  pickupCountry      String?
  pickupPhone        String?
  pickupAt           DateTime?
  pickupAirport      String?
  pickupFlightNumber String?
  pickupMemo         String?

  dropoffLocationId   String?
  dropoffLocation     Location? @relation("TransportDropoff", fields: [dropoffLocationId], references: [id])
  dropoffLocationName String?
  dropoffAddress      String?
  dropoffCity         String?
  dropoffProvince     String?
  dropoffPostal       String?
  dropoffCountry      String?
  dropoffPhone        String?
  dropoffAt           DateTime?
  dropoffAirline      String?
  frequentFlyerNumber String?
  dropoffMemo         String?
}

enum RentalStatus {
  OPEN
  CLOSED
  VOIDED
}

/// Rental Agreement (CheckOut3 form + check-in).
model Rental {
  id       String       @id @default(cuid())
  raNumber Int          @unique @default(autoincrement())
  legacyId Int?         @unique
  status   RentalStatus @default(OPEN)

  reservationId String?      @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  quoteId       String?
  quote         Quote?       @relation(fields: [quoteId], references: [id])
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id])
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id])

  checkOutLocationId String
  checkOutLocation   Location  @relation("RentalCheckOutLocation", fields: [checkOutLocationId], references: [id])
  checkInLocationId  String
  checkInLocation    Location  @relation("RentalCheckInLocation", fields: [checkInLocationId], references: [id])
  checkOutAt         DateTime
  expectedReturnAt   DateTime
  checkedInAt        DateTime?
  checkOutChannel    String? /// VERIFY values
  checkInChannel     String?

  vehicleTypeId String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])
  vehicleId     String
  vehicle       Vehicle     @relation(fields: [vehicleId], references: [id])
  odometerOut   Int
  odometerIn    Int?
  fuelOut       Int? /// sixteenths
  fuelIn        Int?
  prepaidFuel   Boolean     @default(false)

  rateId           String?
  rate             Rate?         @relation(fields: [rateId], references: [id])
  /// "Rate (i)" Rate Details: this booking's own rate values, replacing the rate's (RateDetails.aspx) — see lib/rate-override.ts
  rateOverride     Json?
  discountType     DiscountType?
  discountValue    Decimal?      @db.Decimal(10, 2)
  discountReasonId String?
  discountReason   Lookup?       @relation("RentalDiscountReason", fields: [discountReasonId], references: [id])
  deposit          Decimal?      @db.Decimal(10, 2)
  isLongTerm       Boolean       @default(false)
  invoicingPeriod  String? /// VERIFY options (empty on live form)

  referralId     String?
  referral       Referral? @relation(fields: [referralId], references: [id])
  rentalReasonId String?
  rentalReason   Lookup?   @relation("RentalReason", fields: [rentalReasonId], references: [id])
  claimNumber    String?
  airport        String?
  airline        String?
  flightNumber   String?
  poNumber       String?
  roNumber       String?
  isNonRevenue   Boolean   @default(false)

  openedById String?
  openedBy   User?     @relation("RentalOpenedBy", fields: [openedById], references: [id])
  closedById String?
  closedBy   User?     @relation("RentalClosedBy", fields: [closedById], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  voidedAt   DateTime?
  deletedAt  DateTime?

  excludedTaxIds String[] @default([]) /// taxes unticked in the options grid
  exchangeRate   Decimal? @db.Decimal(12, 6) /// "Update Exchange Rate" action — CONFIRM: still used?

  drivers         BookingDriver[]
  chargeLines     ChargeLine[]
  payments        Payment[]
  memos           Memo[]
  attachments     Attachment[]
  inspections     VehicleInspection[]
  reportedDamages CustomerReportedDamage[]
  vehicleBlock    VehicleBlock?
  vehicleSegments RentalVehicleSegment[]
  trafficTickets  TrafficTicket[]
  adjustments     Adjustment[]
  billSplits      BillSplit[]
  commissions     Commission[]
  claims          Claim[]
  invoices        RentalInvoice[]
  transports      Transport[]

  @@index([status, checkOutLocationId])
  @@index([expectedReturnAt])
}

/// Additional drivers on a reservation or rental.
model BookingDriver {
  id            String       @id @default(cuid())
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id])
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  rentalId      String?
  rental        Rental?      @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@unique([reservationId, customerId])
  @@unique([rentalId, customerId])
}

/// Mirrors the legacy charge table + Adjustment "Item Type" list:
/// Time, Mileage, Upgrade, Fuel, Prepaid Fuel, Traffic Tickets, Discount, Other Charges 1-4,
/// One way, Damages, then every Misc Charge, Admin Charge and taxes.
enum ChargeKind {
  TIME // Hourly / Daily / Weekly / Monthly
  MILEAGE // Km Allowed / KM Driven / extra km
  UPGRADE
  DISCOUNT
  FUEL
  PREPAID_FUEL
  PROTECTION // from Insurance catalogue (damage waivers, SLC, No Protection)
  MISC // from MiscCharge catalogue (damage waiver, additional driver, energy recovery fee, ...)
  ONE_WAY
  DAMAGES
  TRAFFIC_TICKETS
  ADMIN // "Admin Charge"
  OTHER // "Other Charges 1-4"
  TAX
}

/// The charge-table row shape shared by Quote, Reservation and Rental: name · unit · rate · total.
/// Exactly one of quoteId / reservationId / rentalId is set (CHECK constraint in SQL migration).
model ChargeLine {
  id            String       @id @default(cuid())
  quoteId       String?
  quote         Quote?       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  rentalId      String?
  rental        Rental?      @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  kind          ChargeKind
  name          String
  units         Decimal      @db.Decimal(10, 2)
  rate          Decimal      @db.Decimal(10, 2)
  total         Decimal      @db.Decimal(10, 2)
  miscChargeId  String?
  miscCharge    MiscCharge?  @relation(fields: [miscChargeId], references: [id])
  insuranceId   String?
  insurance     Insurance?   @relation(fields: [insuranceId], references: [id])
  taxId         String?
  tax           Tax?         @relation(fields: [taxId], references: [id])
  sortOrder     Int          @default(0)

  @@index([quoteId])
  @@index([reservationId])
  @@index([rentalId])
}

enum PaymentMethod {
  AMEX
  CASH
  DEBIT
  EMT // Interac e-Transfer
  INTERNAL
  MASTERCARD
  VISA
  OTHER // a location's own method (Settings > Payment Methods); the name is in Payment.methodName
}

enum PaymentTransactionType {
  PAYMENT
  AUTHORIZATION
  REFUND
}

model Payment {
  id                String                 @id @default(cuid())
  legacyId          Int?                   @unique
  reservationId     String?
  reservation       Reservation?           @relation(fields: [reservationId], references: [id])
  rentalId          String?
  rental            Rental?                @relation(fields: [rentalId], references: [id])
  customerId        String?
  customer          Customer?              @relation(fields: [customerId], references: [id])
  method            PaymentMethod
  methodName        String? /// name of a location's own payment method when method = OTHER (e.g. Cheque, Direct Bill Company)
  transactionType   PaymentTransactionType
  amount            Decimal                @db.Decimal(10, 2)
  authorizationCode String?
  transactionCode   String?
  creditCardId      String?
  creditCard        CreditCard?            @relation(fields: [creditCardId], references: [id])
  cardLast4         String?
  takenById         String?
  takenBy           User?                  @relation("PaymentTakenBy", fields: [takenById], references: [id])
  takenAt           DateTime               @default(now())
  paymentDetail     String? /// VERIFY options ("----NONE-----" on live form)
  paymentDetailCont String?
  companyId         String? /// payment received from a company (insurer, body shop, …)
  company           Company?               @relation(fields: [companyId], references: [id])

  @@index([reservationId])
  @@index([rentalId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cross-cutting: memos & attachments
// ─────────────────────────────────────────────────────────────────────────────

/// Staff memo history (e.g. "emailed for paying ticket on feb14"). "Always display as popup"
/// is preserved as showAsPopup.
enum MemoKind {
  MEMO // "Memo" + "Memo History"
  NOTE // separate "Notes" list on the rental
}

model Memo {
  id            String       @id @default(cuid())
  kind          MemoKind     @default(MEMO)
  body          String
  showAsPopup   Boolean      @default(false)
  authorId      String?
  author        User?        @relation("MemoAuthor", fields: [authorId], references: [id])
  createdAt     DateTime     @default(now())
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId     String?
  vehicle       Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  quoteId       String?
  quote         Quote?       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  rentalId      String?
  rental        Rental?      @relation(fields: [rentalId], references: [id], onDelete: Cascade)
}

enum AttachmentKind {
  IMAGE
  DOCUMENT
  SCANNED_ID
}

/// S3 objects: vehicle photos/documents, customer scanned IDs, rental documents.
model Attachment {
  id               String                  @id @default(cuid())
  kind             AttachmentKind
  s3Key            String                  @unique
  fileName         String
  contentType      String
  sizeBytes        Int
  /// "Description" (VehicleDocumentsAdd.aspx)
  description      String?
  uploadedAt       DateTime                @default(now())
  vehicleId        String?
  vehicle          Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customerId       String?
  customer         Customer?               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rentalId         String?
  rental           Rental?                 @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  /// photos of an inspection / a customer-reported damage / a damage record (VehicleDamage.imageKey keeps the first)
  inspectionId     String?
  inspection       VehicleInspection?      @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  reportedDamageId String?
  reportedDamage   CustomerReportedDamage? @relation(fields: [reportedDamageId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// Rental sub-records (live Rental detail screen, AgreementMain.aspx)
// ─────────────────────────────────────────────────────────────────────────────

/// "Vehicle Exchange": every vehicle the renter had during the rental, in order. The first
/// segment is the original vehicle (legacy lists it the same way).
model RentalVehicleSegment {
  id          String    @id @default(cuid())
  rentalId    String
  rental      Rental    @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id])
  startsAt    DateTime
  endsAt      DateTime?
  odometerOut Int
  odometerIn  Int?
  fuelOut     Int? /// sixteenths
  fuelIn      Int?
  sequence    Int       @default(0)
}

/// "Traffic Tickets" (TrafficTicketsModify.aspx)
model TrafficTicket {
  id                String         @id @default(cuid())
  rentalId          String
  rental            Rental         @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  ticketDate        DateTime
  offense           String
  location          String?
  amount            Decimal        @db.Decimal(10, 2)
  officer           String?
  city              String?
  province          String?
  country           String?
  payMethod         PaymentMethod?
  creditCardId      String?
  processCreditCard Boolean        @default(false)
  isPaid            Boolean        @default(false)
  memo              String?
  attachmentKey     String? // S3 key of the uploaded ticket
  createdAt         DateTime       @default(now())
}

/// "Adjustments": an amount against one charge category or misc charge.
model Adjustment {
  id           String      @id @default(cuid())
  rentalId     String
  rental       Rental      @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  kind         ChargeKind
  miscChargeId String?
  miscCharge   MiscCharge? @relation(fields: [miscChargeId], references: [id])
  name         String /// item name as shown ("Time", "Other Charges 2", "Energy Recovery Fee" …)
  amount       Decimal     @db.Decimal(10, 2)
  enteredById  String?
  enteredBy    User?       @relation("AdjustmentEnteredBy", fields: [enteredById], references: [id])
  enteredAt    DateTime    @default(now())
}

enum ClaimType {
  RENTER
  THIRD_PARTY
  OTHER
}

/// "Bill Split": part of the rental billed to a company (insurer / ICBC / body shop / corporate).
model BillSplit {
  id                         String         @id @default(cuid())
  /// Belongs to a reservation or a rental (moves to the rental at Start Rental).
  rentalId                   String?
  rental                     Rental?        @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  reservationId              String?
  reservation                Reservation?   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  companyId                  String
  company                    Company        @relation(fields: [companyId], references: [id])
  claimType                  ClaimType
  insuranceCompany           String?
  policyNumber               String?
  policyExpiry               DateTime?      @db.Date
  prePaid                    Decimal        @default(0) @db.Decimal(10, 2)
  lumpSum                    Decimal        @default(0) @db.Decimal(10, 2)
  amountPerDay               Decimal        @db.Decimal(10, 2)
  numberOfDays               Int
  adjuster                   String? /// VERIFY: dropdown of the company's adjusters
  insured                    String?
  roNumber                   String?
  poNumber                   String?
  lossDate                   DateTime?      @db.Date
  claimNumber                String?
  maxPay                     Decimal?       @db.Decimal(10, 2)
  percentCoPay               Int            @default(0)
  payAllTaxes                Boolean        @default(false)
  taxes                      BillSplitTax[]
  payTotal                   Boolean        @default(false)
  deductFromCustomersBalance Boolean        @default(false)
  memo                       String?
  createdAt                  DateTime       @default(now())
}

model BillSplitTax {
  billSplitId String
  billSplit   BillSplit @relation(fields: [billSplitId], references: [id], onDelete: Cascade)
  taxId       String
  tax         Tax       @relation(fields: [taxId], references: [id])

  @@id([billSplitId, taxId])
}

/// "Commissions": paid to a referral source or a staff user.
model Commission {
  id          String    @id @default(cuid())
  rentalId    String
  rental      Rental    @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  amount      Decimal   @db.Decimal(10, 2)
  referralId  String?
  referral    Referral? @relation(fields: [referralId], references: [id])
  userId      String?
  user        User?     @relation("CommissionUser", fields: [userId], references: [id])
  enteredById String?
  enteredBy   User?     @relation("CommissionEnteredBy", fields: [enteredById], references: [id])
  enteredAt   DateTime  @default(now())
}

enum ClaimStatus {
  OPEN
  PENDING
  CLOSED
}

/// "Claims" (ClaimsModify.aspx). CONFIRM: legacy also has "Claims V2" — which one is in use?
model Claim {
  id                       String      @id @default(cuid())
  /// the rental the claim is for; empty for a claim added on the vehicle (Vehicle Claims)
  rentalId                 String?
  rental                   Rental?     @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  vehicleId                String?
  vehicle                  Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  claimDate                DateTime
  claimNumber              String?
  closeDate                DateTime?
  type                     ClaimType
  location                 String?
  policeDept               String?
  policeRep                String?
  status                   ClaimStatus @default(OPEN)
  deductible               Decimal?    @db.Decimal(10, 2)
  totalPayments            Decimal?    @db.Decimal(10, 2)
  memo                     String?
  hasAccidentReport        Boolean     @default(false)
  hasRenterInsurancePolicy Boolean     @default(false)
  hasPoliceReport          Boolean     @default(false)
  hasRentalAgreement       Boolean     @default(false)
  createdAt                DateTime    @default(now())
}

/// "Invoices": periodic invoices on long-term rentals (+ "Add Credit Invoice").
model RentalInvoice {
  id            String   @id @default(cuid())
  rentalId      String
  rental        Rental   @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  invoiceNumber Int      @unique @default(autoincrement())
  numberOfDays  Int
  beginDate     DateTime
  endDate       DateTime
  amount        Decimal  @db.Decimal(10, 2)
  isCredit      Boolean  @default(false)
  createdAt     DateTime @default(now())
}

/// Field-level change history ("Agreements Log": date, user, field, old value, new value).
/// Generic so reservations, vehicles and customers get the same history.
model AuditLog {
  id         String   @id @default(cuid())
  entityType String /// "Rental", "Reservation", …
  entityId   String
  field      String
  oldValue   String?
  newValue   String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  ipAddress  String?
  at         DateTime @default(now())

  @@index([entityType, entityId, at])
}

/// "Club Member" (CustomersMemberInfo.aspx). Customer.isClubMember stays as the quick flag.
model ClubMembership {
  id         String    @id @default(cuid())
  customerId String    @unique
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  gCode      String?
  cardNumber String?
  issuedAt   DateTime? @db.Date
  expiresAt  DateTime? @db.Date
  sentAt     DateTime? @db.Date
  status     String? /// VERIFY options
}

/// Settings > Payment Settings > Payment Gateway. Keys are entered by an admin in the ERP; secrets are stored encrypted
/// (AES-256-GCM, see packages/api/src/lib/secrets.ts) and never sent back to the browser.
model PaymentGateway {
  id               String   @id @default(cuid())
  provider         String   @unique /// "STRIPE"
  isActive         Boolean  @default(false)
  testMode         Boolean  @default(true)
  publishableKey   String?
  secretKeyEnc     String?
  webhookSecretEnc String?
  /// online bookings: SAVE_CARD = keep the card for the counter (Stripe SetupIntent); AUTHORIZE = hold the total (manual-capture PaymentIntent)
  onlineMode       String   @default("SAVE_CARD")
  updatedAt        DateTime @updatedAt
  updatedById      String?
}

/// Settings > Rental Contracts & Invoices > Rentals & Invoices (AgreementFormsMain.aspx): printable / emailable HTML templates
/// with ##code## placeholders (RentCentric's numbering, see packages/api/src/lib/template-fields.ts). Admins edit them.
model DocumentTemplate {
  id            String    @id @default(cuid())
  legacyId      Int?      @unique
  locationId    String?
  location      Location? @relation(fields: [locationId], references: [id])
  name          String
  /// AGREEMENT (rental printouts, invoices) | RESERVATION (confirmation) | QUOTE
  kind          String    @default("AGREEMENT")
  html          String
  isActive      Boolean   @default(true)
  isDefault     Boolean   @default(false)
  autoPrint     Boolean   @default(false)
  emailFriendly Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  updatedById   String?

  @@index([locationId, kind])
}

/// Settings > Website & Email Setup > Email Setup: the SMTP account outgoing email is sent from. One row.
model EmailSettings {
  id          String   @id @default("default")
  isActive    Boolean  @default(false)
  host        String?
  port        Int      @default(587)
  /// true = TLS from the start (port 465); false = STARTTLS when offered (587)
  secure      Boolean  @default(false)
  username    String?
  passwordEnc String?
  fromName    String?  @default("Mr Rent A Car")
  fromEmail   String?
  /// copy every email sent to this address (optional)
  bccEmail    String?
  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// Every email the system sends (agreements, invoices, confirmations, quotes), for the record.
model EmailLog {
  id           String   @id @default(cuid())
  to           String
  subject      String
  /// RENTAL | RESERVATION | QUOTE
  entityType   String?
  entityId     String?
  templateName String?
  status       String /// SENT | FAILED
  error        String?
  sentById     String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Vehicle page records (RentCentric VehicleMain.aspx actions; fields as on each *Modify.aspx form)
// ─────────────────────────────────────────────────────────────────────────────

/// Maintenance (VehicleMaintenanceModify.aspx)
model VehicleMaintenance {
  id               String         @id @default(cuid())
  vehicleId        String
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date             DateTime /// "Current Maintenance Date"
  type             String? /// "Current Maintenance Type"
  odometer         Int? /// "Current Maintenance Odometer"
  nextDateRequired Boolean        @default(false) /// "Future Maintenance Reminder"
  nextDate         DateTime?
  nextType         String?
  nextOdometer     Int?
  shop             String?
  shopContactName  String?
  shopPhone        String?
  labourCost       Decimal?       @db.Decimal(10, 2)
  partsCost        Decimal?       @db.Decimal(10, 2)
  paymentMethod    PaymentMethod?
  paymentAmount    Decimal?       @db.Decimal(10, 2)
  poNumber         String?
  memo             String?
  enteredById      String?
  createdAt        DateTime       @default(now())

  @@index([vehicleId, date])
}

/// Repairs (VehicleRepairsModify.aspx)
model VehicleRepair {
  id                  String    @id @default(cuid())
  vehicleId           String
  vehicle             Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date                DateTime /// "Repair Date"
  dateDue             DateTime?
  pickupDate          DateTime? /// out to the shop
  returnDate          DateTime?
  pickupLocationId    String?
  returnLocationId    String?
  odometerOut         Int?
  odometerIn          Int?
  shopName            String?
  totalParts          Decimal?  @db.Decimal(10, 2)
  totalLabour         Decimal?  @db.Decimal(10, 2)
  repairOrderNumber   String?
  purchaseOrderNumber String?
  description         String?
  enteredById         String?
  createdAt           DateTime  @default(now())

  @@index([vehicleId, date])
}

/// Problems (VehicleProblemsModify.aspx); Status also changes the vehicle's status
model VehicleProblem {
  id          String         @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date        DateTime
  odometer    Int?
  status      VehicleStatus?
  description String?
  enteredById String?
  createdAt   DateTime       @default(now())

  @@index([vehicleId, date])
}

/// Carwash (VehicleCarwashModify.aspx)
model VehicleCarwash {
  id             String   @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date           DateTime
  odometer       Int?
  updateOdometer Boolean  @default(false)
  washedBy       String? /// "Car Washed By"
  spotNumber     String?
  memo           String?
  enteredById    String?
  createdAt      DateTime @default(now())

  @@index([vehicleId, date])
}

/// Damage (VehicleDamagesModify2.aspx): one line per damaged spot
model VehicleDamage {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date        DateTime
  rentalId    String? /// the rental the damage happened on
  locationId  String?
  location    Lookup?  @relation("DamageLocation", fields: [locationId], references: [id])
  conditionId String?
  condition   Lookup?  @relation("DamageCondition", fields: [conditionId], references: [id])
  total       Decimal  @db.Decimal(10, 2)
  imageKey    String? /// photo (needs file storage)
  memo        String?
  enteredById String?
  createdAt   DateTime @default(now())

  @@index([vehicleId, date])
}

/// Accidents (VehicleAccidentsModify.aspx)
model VehicleAccident {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date        DateTime
  rentalId    String? /// "Rental #"
  fullName    String?
  location    String?
  description String?
  memo        String?
  enteredById String?
  createdAt   DateTime @default(now())

  @@index([vehicleId, date])
}

/// Vehicle Services (VehicleServicesModify.aspx): service vouchers
model VehicleServiceVoucher {
  id             String    @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  companyName    String
  voucherNumber  String?
  expirationDate DateTime? @db.Date
  memo           String?
  enteredById    String?
  createdAt      DateTime  @default(now())
}

enum VehicleInsuranceAction {
  NO_INSURANCE
  FULL_COVERAGE
  LIABILITY_ONLY
  COMPREHENSIVE_ONLY
}

/// Insurances (VehicleInsurancesModify.aspx)
model VehicleInsuranceRecord {
  id               String                 @id @default(cuid())
  vehicleId        String
  vehicle          Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date             DateTime
  expiryDate       DateTime?              @db.Date
  actionType       VehicleInsuranceAction
  insuranceAmount  Decimal?               @db.Decimal(10, 2)
  deductibleAmount Decimal?               @db.Decimal(10, 2)
  policyNumber     String?
  reason           String? /// "Reason for Add/Remove"
  enteredById      String?
  createdAt        DateTime               @default(now())
}

/// Status Change (VehicleStatusChangeModify.aspx); also sets the vehicle's status
model VehicleStatusChange {
  id          String         @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  status      VehicleStatus
  fromStatus  VehicleStatus?
  changedAt   DateTime
  dueBackAt   DateTime?
  enteredById String?
  createdAt   DateTime       @default(now())

  @@index([vehicleId, changedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Tasks (RentCentric TasksModify.aspx / TasksMain.aspx "My Tasks" / TasksList.aspx)
// ─────────────────────────────────────────────────────────────────────────────

enum TaskStatus {
  OPEN
  CLOSED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

model Task {
  id          String         @id @default(cuid())
  date        DateTime /// "Date"
  subject     String
  description String? /// "Task"
  status      TaskStatus     @default(OPEN)
  priority    TaskPriority   @default(NORMAL)
  emailTask   Boolean        @default(false) /// "Email Task": e-mail the assignees when saved
  enteredById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  assignees   TaskAssignee[]

  @@index([date])
}

/// "Assigned To" (one or more staff)
model TaskAssignee {
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String

  @@id([taskId, userId])
  @@index([userId])
}

/// Settings > Payment Settings > Payment Methods (PayMethodsAdd.aspx): a location's own payment methods, offered
/// next to the built-in ones (Visa, Cash, Mastercard, Amex, Debit, Internal, EMT).
model LocationPaymentMethod {
  id                  String   @id @default(cuid())
  locationId          String
  location            Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name                String /// "Payment Method"
  isCreditCard        Boolean  @default(false)
  creditCardType      String?
  isDefault           Boolean  @default(false)
  mobileAgentIncluded Boolean  @default(false) /// "Is Mobile Agent Included"
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  @@unique([locationId, name])
}

enum InspectionKind {
  PICKUP /// at check-out
  RETURN /// at check-in
  OTHER
}

/// "Vehicle Inspection" (VehicleInspection.aspx: Admin, Date, Images). RentCentric fills these from its inspection app;
/// here staff add them (with photos) from the vehicle, reservation or rental. Pickup + return inspections of one rental
/// make the "Inspection Comparison".
model VehicleInspection {
  id            String         @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  kind          InspectionKind @default(OTHER)
  at            DateTime
  reservationId String?
  reservation   Reservation?   @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  rentalId      String?
  rental        Rental?        @relation(fields: [rentalId], references: [id], onDelete: SetNull)
  odometer      Int?
  fuel          Int? /// sixteenths
  memo          String?
  adminId       String? /// "Admin": who inspected
  images        Attachment[]
  createdAt     DateTime       @default(now())

  @@index([vehicleId, at])
}

/// "Customer Reported Damages" (CustomerReportedDamages.aspx: Date Entered, Customer, Description, Reservation #,
/// Rental #, Condition, Location, Images, Delete).
model CustomerReportedDamage {
  id            String       @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  rentalId      String?
  rental        Rental?      @relation(fields: [rentalId], references: [id], onDelete: SetNull)
  description   String
  conditionId   String?
  condition     Lookup?      @relation("ReportedDamageCondition", fields: [conditionId], references: [id])
  locationId    String?
  location      Lookup?      @relation("ReportedDamageLocation", fields: [locationId], references: [id])
  images        Attachment[]
  enteredById   String?
  createdAt     DateTime     @default(now())

  @@index([vehicleId, createdAt])
}

/// Settings > Vehicle CheckList (VehicleCheckListAdd.aspx: Vehicle CheckList Name, Vehicle Types, Memo).
model VehicleChecklist {
  id             String                 @id @default(cuid())
  name           String
  /// the vehicle types it applies to; empty = all ("All Vehicle Types")
  vehicleTypeIds String[]               @default([])
  memo           String?
  isActive       Boolean                @default(true)
  items          VehicleChecklistItem[]
  createdAt      DateTime               @default(now())
}

enum ChecklistColor {
  NONE
  RED
  GREEN
}

/// Settings > Vehicle CheckList Items (VehicleCheckListItemsAdd.aspx: Vehicle CheckList Name, Item Name, Status Color, Memo, Vehicle Types).
model VehicleChecklistItem {
  id             String                   @id @default(cuid())
  checklistId    String
  checklist      VehicleChecklist         @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  name           String
  statusColor    ChecklistColor           @default(NONE)
  vehicleTypeIds String[]                 @default([])
  memo           String?
  sortOrder      Int                      @default(0)
  results        VehicleChecklistResult[]
}

enum DeliveryOrPickup {
  PICKUP
  DELIVERY
}

/// A vehicle's checklist for a booking (VehicleCheckListOutReturnModify.aspx: Reservation #, Full Name, Pickup Date,
/// Return Date, Milage, Delivery Or PickUp, Memo, then each checklist's items with a Note).
model VehicleChecklistRecord {
  id               String                   @id @default(cuid())
  vehicleId        String
  vehicle          Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  reservationId    String?
  reservation      Reservation?             @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  pickupAt         DateTime
  returnAt         DateTime
  mileage          Int?
  deliveryOrPickup DeliveryOrPickup         @default(PICKUP)
  memo             String?
  results          VehicleChecklistResult[]
  enteredById      String?
  createdAt        DateTime                 @default(now())

  @@index([vehicleId, pickupAt])
}

model VehicleChecklistResult {
  recordId String
  record   VehicleChecklistRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  itemId   String
  item     VehicleChecklistItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  checked  Boolean                @default(false)
  note     String?

  @@id([recordId, itemId])
}

enum SignatureCondition {
  ADDED /// "is added"
  NOT_ADDED /// "is not added"
  ALWAYS /// "always on"
}

enum SignatureType {
  SIGNATURE
  INITIALS
}

/// Settings > Signature And Initials (SignatureSetupsModify.aspx: Name, Code, Condition, Signature Type, Effective Date,
/// End Date, Misc Charge, Insurance, Disclaimer, Active). Printouts show the disclaimer with a signature / initials line
/// at ##Signature\<Code>## when the misc charge / insurance is (not) on the booking, between the two dates.
model SignatureSetup {
  id            String             @id @default(cuid())
  name          String
  code          String             @unique
  condition     SignatureCondition @default(ADDED)
  type          SignatureType      @default(SIGNATURE)
  effectiveDate DateTime           @db.Date
  endDate       DateTime           @db.Date
  miscChargeId  String?
  miscCharge    MiscCharge?        @relation(fields: [miscChargeId], references: [id], onDelete: SetNull)
  insuranceId   String?
  insurance     Insurance?         @relation(fields: [insuranceId], references: [id], onDelete: SetNull)
  disclaimer    String             @default("")
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
}

/// Ownership Information (VehicleLeaseInfo.aspx): purchase, finance / lease, owner, sale, title and depreciation, one per vehicle.
model VehicleOwnership {
  vehicleId            String    @id
  vehicle              Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  price                Decimal?  @db.Decimal(12, 2) /// Price
  loanNumber           String? /// Loan Number
  buyBackValue         Decimal?  @db.Decimal(12, 2) /// Buy Back Value
  bank                 String? /// Bank
  monthlyPayment       Decimal?  @db.Decimal(12, 2) /// Monthly Payment
  leaseTerm            String? /// Lease Term
  acquisitionType      String? /// Acquisition Type
  financeAmount        Decimal?  @db.Decimal(12, 2) /// Finance Amount
  acquisitionDate      DateTime? @db.Date /// Acquisition Date
  financeDate          DateTime? @db.Date /// Finance Date
  acquisitionPrice     Decimal?  @db.Decimal(12, 2) /// Acquisition Price
  interestRate         Decimal?  @db.Decimal(10, 4) /// Interest Rate
  sellingCompanyId     String? /// Selling Company
  interestStartDate    DateTime? @db.Date /// Interest Start Date
  cleanWholesale       Decimal?  @db.Decimal(12, 2) /// Clean Wholesale
  paymentAmount        Decimal?  @db.Decimal(12, 2) /// Payment Amount
  avgAuctionValue      Decimal?  @db.Decimal(12, 2) /// average auction value
  firstPaymentDate     DateTime? @db.Date /// First Payment Date
  ownerCity            String? /// Owner City
  ownerFirstName       String? /// Owner First Name
  lastAmortizationDate DateTime? @db.Date /// Last Amortization Date
  ownerLastName        String? /// Owner Last Name
  payoffAmount         Decimal?  @db.Decimal(12, 2) /// Payoff Amount
  ownerAddress         String? /// Owner Address
  askingPrice          Decimal?  @db.Decimal(12, 2) /// Asking Price
  ownerState           String? /// Owner State
  dateSold             DateTime? @db.Date /// Date Sold
  ownerZip             String? /// Owner Zip
  salesPrice           Decimal?  @db.Decimal(12, 2) /// Sales Price
  ownerPhone           String? /// Owner Phone
  isSold               Boolean   @default(false) /// Sold
  soldMethod           String? /// Sold Method
  ownerFax             String? /// Owner Fax
  remainingPayments    Int? /// Remaining Payments
  registeredOwner      String? /// Registered Owner
  buyer                String? /// Buyer
  registeredOwnerCont  String? /// Registered Owner Cont.
  outOfServiceOdometer Int? /// Out Of Service Odometer
  outOfServiceDate     DateTime? @db.Date /// Out Of Service Date
  titleComment         String? /// Title Comment
  sellOnline           Boolean   @default(false) /// Sell Online
  history              String? /// History
  balanceOwed          Decimal?  @db.Decimal(12, 2) /// Balance Owed
  titleLocation        String? /// Title Location
  titleLocationCont    String? /// Title Location Cont.
  titleDate            DateTime? @db.Date /// Title Date
  firstMonthDep        Decimal?  @db.Decimal(12, 2) /// First Month Dep.
  lastMonthDep         Decimal?  @db.Decimal(12, 2) /// Last Month Dep.
  bookRetail           Decimal?  @db.Decimal(12, 2) /// Book Retail Book Value
  accumulatedDep       Decimal?  @db.Decimal(12, 2) /// Accumulated Dep.
  residual             Decimal?  @db.Decimal(12, 2) /// Residual
  depOdometer          Int? /// Odometer
  moDepAmt             Decimal?  @db.Decimal(12, 2) /// Mo. Dep. Amt.
  startLicDepDate      DateTime? @db.Date /// Start Lic. Dep.
  dailyDepPercent      Decimal?  @db.Decimal(10, 4) /// Daily Dep.%
  lastLicDepDate       DateTime? @db.Date /// Last Lic. Dep.
  moDepPercent         Decimal?  @db.Decimal(10, 4) /// Mo. Dep.%
  accumLicDep          Decimal?  @db.Decimal(12, 2) /// Accum Lic. Dep.
  startDepDate         DateTime? @db.Date /// Start Dep.
  lastDepDate          DateTime? @db.Date /// Last Dep. Date
  sellingCompany       Company?  @relation("VehicleOwnershipSeller", fields: [sellingCompanyId], references: [id], onDelete: SetNull)
  updatedAt            DateTime  @updatedAt
}

/// Vehicle Condition (VehicleConditions.aspx): per component (Fairing … Other Accessories, General Conditions) the ticked
/// conditions (E Excellent, G Good, F Fair, P Poor, N None, D Damaged), and Special Comment 1-4 (printed as
/// VehicleConditionComment1-4 on contracts).
model VehicleCondition {
  vehicleId String   @id
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// { "Fairing": ["G"], "Front Tire": ["F", "D"], … }
  ratings   Json     @default("{}")
  comment1  String?
  comment2  String?
  comment3  String?
  comment4  String?
  updatedAt DateTime @updatedAt
}

/// Settings > One Way Regions (LocationRegionsMain.aspx: Region). Each location belongs to one (Location.oneWayRegionId).
model OneWayRegion {
  id        String       @id @default(cuid())
  name      String       @unique
  locations Location[]
  ratesFrom OneWayRate[] @relation("OneWayFrom")
  ratesTo   OneWayRate[] @relation("OneWayTo")
}

/// Settings > One Way Rates (OneWaysModify.aspx: One Way From, One Way To, Add Reverse, Fee, Odometer, Number of Days,
/// Vehicle Type (empty = All), Competition Rate 1-3, Start Date, End Date, Memo). A booking whose pickup and return
/// locations are in different regions gets the fee as its "One Way" charge.
model OneWayRate {
  id               String       @id @default(cuid())
  fromRegionId     String
  fromRegion       OneWayRegion @relation("OneWayFrom", fields: [fromRegionId], references: [id], onDelete: Cascade)
  toRegionId       String
  toRegion         OneWayRegion @relation("OneWayTo", fields: [toRegionId], references: [id], onDelete: Cascade)
  fee              Decimal      @db.Decimal(10, 2)
  odometer         Int?
  numberOfDays     Int?
  vehicleTypeId    String?
  vehicleType      VehicleType? @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  competitionRate1 Decimal?     @db.Decimal(10, 2)
  competitionRate2 Decimal?     @db.Decimal(10, 2)
  competitionRate3 Decimal?     @db.Decimal(10, 2)
  startDate        DateTime     @db.Date
  endDate          DateTime     @db.Date
  memo             String?

  @@index([fromRegionId, toRegionId])
}
